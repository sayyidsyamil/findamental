# Telegram is handled by your existing Hermes gateway.
# These are only used by local Findamental scripts when needed.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_USER_ID=your_telegram_user_id_here

# LLM — pick ONE of the two blocks below.

# (A) Local LM Studio / Ollama / any OpenAI-compatible endpoint
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=gemma-4-e4b-uncensored-hauhaucs-aggressive
# LLM_API_KEY=not-needed   # only needed if your server requires it

# (B) OpenRouter (cloud)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=your_openrouter_key_here
# LLM_MODEL=deepseek/deepseek-v4-flash

# Legacy aliases (still respected as fallbacks)
# OPENROUTER_API_KEY=your_openrouter_key_here
# OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# Paths
FINDAMENTAL_DATA_DIR=./data
FINDAMENTAL_CACHE_DIR=./data/extracted_cache

# Behavior
LOG_LEVEL=INFO

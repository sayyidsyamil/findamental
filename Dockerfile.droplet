FROM python:3.12-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*
RUN pip install uv
COPY pyproject.toml ./
COPY README.md ./
COPY src ./src
RUN uv pip install -e . --system
COPY . .
CMD ["findamental-query", "Maybank Q3 2024 revenue"]
